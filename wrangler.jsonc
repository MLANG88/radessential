{
  // Cloudflare Worker: static site from ./dist plus the /api/ddx endpoint (Workers AI). Build: npm run build · Deploy: npx wrangler deploy
  "name": "radessential",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" }
}
